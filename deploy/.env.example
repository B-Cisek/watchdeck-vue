# Copy to /opt/watchdeck-vue/.env on the VPS and fill in.

# --- image ---
# GitHub user/org that owns the repo, lowercase
GHCR_OWNER=your-github-user

# --- Traefik (match your existing Traefik setup) ---
# Domain of the SPA. DOMAIN/api/* is proxied to the backend, whatever domain it has itself.
DOMAIN=watchdeck.example.com
# Backend's Traefik service (traefik.http.services.<name> in ../watchdeck/.deploy/docker-compose.yml)
API_SERVICE=watchdeck@docker
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=cf
